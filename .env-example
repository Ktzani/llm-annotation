# Exemplo de arquivo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves de API

# Hugging-face Access Token
# Provider "transformers" (local): usado só para BAIXAR pesos de modelos gated
# (ex.: meta-llama) — a inferência roda na máquina e não consome créditos.
HUGGINGFACEHUB_API_TOKEN=hf_xxxxx

# GROQ Access Token
GROQ_API_KEY=gsk_xxxxx

# TOGETHER Access Token
TOGETHER_API_KEY=together_xxxxx

# Interface web da validação humana (src/run_human_validation.py, mode="interface")
# Códigos de acesso: nunca versionar os reais
HV_ADMIN_CODE=troque-este-codigo
HV_CODE_AVALIADOR_1=codigo1
HV_CODE_AVALIADOR_2=codigo2
HV_CODE_AVALIADOR_3=codigo3
# Só para o deploy via Docker (no run_human_validation.py ficam estáticos no main)
HV_EXPERIMENTS=books:2026-04-09_13-21-37,dblp:2026-04-09_14-05-21
HV_RESULTS_DIR=/app/data/results
# HV_DB_PATH=/app/data/results/validacao_humana.db
# HV_INCREMENT_SIZE=20

# Aviso por email ao fechar uma rodada (Gmail: crie uma senha de app em
# https://myaccount.google.com/apppasswords; exige verificação em duas etapas)
HV_NOTIFY_EMAIL=destinatario@exemplo.com
HV_SMTP_USER=remetente@gmail.com
HV_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# HV_SMTP_HOST=smtp.gmail.com
# HV_SMTP_PORT=587

# Outras configurações opcionais
# RESULTS_DIR=./results
# LOG_LEVEL=INFO
