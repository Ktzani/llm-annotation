{
    "dataset_name": "CENARIO_AGRUPADO_15",
    "dataset_config": {
        "sample_size": null,
        "random_state": 42,
        "remove_texts": true
    },
    "models": [
        "qwen3-8b",
        "mistral-7b",
        "deepseek-r1-8b"
    ],
    "keep_columns": [
        "message_id"
    ],
    "class_prompts_file": "class_prompts.json",
    "custom_prompt": null,
    "annotation": {
        "use_alternative_params": false,
        "model_strategy": "parallel",
        "class_strategy": "parallel",
        "max_concurrent_classes": 10,
        "keep_alive": "24h"
    },
    "cache": {
        "dir": "data/.cache"
    },
    "results": {
        "intermediate": 2,
        "dir": "data/results"
    }
}
