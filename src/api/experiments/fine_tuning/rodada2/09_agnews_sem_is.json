{
    "dataset": {
        "dataset_name": "agnews",
        "cache_dir": "/app/data/.cache",
        "results_dir": "/app/data/results",
        "specific_date": "latest"
    },
    "hyperparams": {
        "learning_rate": 0.00005,
        "num_epochs": 20,
        "train_batch_size": 64,
        "eval_batch_size": 128,
        "weight_decay": 0.01,
        "max_length": 256,
        "seed": 42
    },
    "instance_selection": {
        "enabled": false,
        "method": "bio-is",
        "params": {
            "beta": 0.25,
            "theta": 0.5
        }
    },
    "model_name": "roberta-base",
    "run_name": "roberta-base",
    "run_type": "cross-validation",
    "training_mode": "aggregated",
    "max_parallel_folds": 5
}
