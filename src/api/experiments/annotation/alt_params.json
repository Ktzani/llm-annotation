{
    "dataset_name": "movie_review",
    "dataset_config": {
        "split": null,
        "combine_splits": null,
        "hf_file": "data.parquet",
        "sample_size": 300,
        "random_state": 42,
        "remove_texts": false
    },
    "models": [
        "deepseek-r1-8b",
        "qwen3-8b",
        "llama3.1-8b"
    ],
    "prompt_type": "simpler",
    "custom_prompt": "",
    "annotation": {
        "num_repetitions_per_llm": 1,
        "use_alternative_params": {
            "deepseek-r1-8b": "alt1",
            "qwen3-8b": "alt1",
            "llama3.1-8b": "alt1"
        },
        "model_strategy": "parallel",
        "rep_strategy": "parallel",
        "max_concurrent_texts": 5,
        "keep_alive": "24h"
    },
    "cache": {
        "enabled": false,
        "dir": "/app/data/.cache"
    },
    "results": {
        "intermediate": 100,
        "dir": "/app/data/results/alt_params"
    }
}
