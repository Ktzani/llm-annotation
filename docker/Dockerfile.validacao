# ============================================================
# Interface web da validação humana — imagem leve (sem GPU)
# Só o necessário para amostragem, estimação e a API/telas.
# ============================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir \
        "fastapi>=0.124,<1" \
        "uvicorn>=0.38" \
        "pandas>=2.0,<3" \
        "numpy>=2.0" \
        "scipy>=1.11" \
        "statsmodels>=0.14" \
        "openpyxl>=3.1" \
        "loguru>=0.7" \
        "python-dotenv>=1.0" \
        "pydantic>=2.0"

# Dados (resultados + SQLite) entram por volume, nunca na imagem (.dockerignore)
COPY src ./src

EXPOSE 8001

CMD ["uvicorn", "src.systems.human_validation_system.interface.api.server:create_app_from_env", \
     "--factory", "--host", "0.0.0.0", "--port", "8001"]
