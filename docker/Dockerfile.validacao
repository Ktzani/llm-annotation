# ============================================================
# Interface web da validação humana — imagem leve (sem GPU)
# Só o necessário para amostragem, estimação e a API/telas.
# Usada no Railway (railway.toml) e no docker-compose.validacao.yml.
# ============================================================
FROM python:3.11-slim

# Horários da interface (abertura, "fecha às", durações) no fuso dos avaliadores
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/Sao_Paulo

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
        "fastapi>=0.124,<1" \
        "uvicorn>=0.38" \
        "pandas>=2.0,<3" \
        "numpy>=2.0" \
        "scipy>=1.11" \
        "statsmodels>=0.14" \
        "openpyxl>=3.1" \
        "loguru>=0.7" \
        "python-dotenv>=1.0" \
        "pydantic>=2.0"

# Dados (CSV de consenso, SQLite, rodadas) ficam no volume /app/data, nunca na imagem (.dockerignore)
COPY src ./src

EXPOSE 8001

# Um único processo: o fechamento automático e o SQLite assumem um só servidor.
# PORT é definida pelo Railway; localmente vale 8001.
CMD uvicorn src.systems.human_validation_system.interface.api.server:create_app_from_env \
    --factory --host 0.0.0.0 --port ${PORT:-8001} --workers 1
